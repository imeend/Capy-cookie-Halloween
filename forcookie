AddRandomItemsToBotProfiles = function(count)
    count = count or math.random(3, 8)
    local cleanPool = {}
    for _, entry in ipairs(WeaponCatalog) do
        if entry and entry.key and entry.name and not isJunkName(entry.name) then
            if not isBlacklistedForBotProfile(entry.key, entry.name)
                and not isTrophyItem(entry.key) and not isEvoItem(entry.key)
                and entry.rarity ~= "Chroma" then   -- 🚫 хромы ботам не даём
                table.insert(cleanPool, entry)
            end
        end
    end
    if #cleanPool == 0 then
        WARN("⚠️", "Пул чистых предметов пуст")
        return 0
    end
    local added = 0
    local targets = {}

    -- 1. Реальные боты в workspace
    for name, bot in pairs(FakePlayers) do
        if bot and bot.Parent then
            table.insert(targets, name)
        end
    end

    -- 2. Фейки в лидерборде (без бота в workspace)
    for name, frame in pairs(fakePlayerFrames) do
        if frame and frame.Parent and not FakePlayers[name] then
            table.insert(targets, name)
        end
    end

    if #targets == 0 then
        WARN("⚠️", "Нет ни ботов, ни фейков в лидерборде")
        return 0
    end

    for _, name in ipairs(targets) do
        if not fakeProfileCache[name] then
            pcall(getFakeProfileData, name)
        end
        local cache = fakeProfileCache[name]
        if cache then
            if not cache.inventory then
                cache.inventory = {
                    Weapons = { Owned = { DefaultKnife = 1, DefaultGun = 1 }, Equipped = { Knife = "DefaultKnife", Gun = "DefaultGun" } },
                    Effects = { Owned = {}, Equipped = {} }, Perks = { Owned = {}, Equipped = {} },
                    Emotes = { Owned = {}, Equipped = {} }, Radios = { Owned = {}, Equipped = {} },
                    Pets = { Owned = {}, Equipped = {} }, Uniques = {}
                }
            end
            local inv = cache.inventory
            if not inv.Weapons then inv.Weapons = { Owned = {}, Equipped = { Knife = "DefaultKnife", Gun = "DefaultGun" } } end
            if not inv.Weapons.Owned then inv.Weapons.Owned = {} end
            if not inv.Weapons.Owned.DefaultKnife then inv.Weapons.Owned.DefaultKnife = 1 end
            if not inv.Weapons.Owned.DefaultGun then inv.Weapons.Owned.DefaultGun = 1 end

            for _ = 1, count do
                local entry = cleanPool[math.random(1, #cleanPool)]
                if entry and entry.key then
                    local amt = math.random(1, 3)
                    inv.Weapons.Owned[entry.key] = (inv.Weapons.Owned[entry.key] or 0) + amt
                    added = added + 1
                end
            end

            pcall(function()
                if ViewProfileModule and ViewProfileModule.PlayerInventories then
                    ViewProfileModule.PlayerInventories[name] = nil
                end
            end)
        end
    end

    LOG("➕", "Random items added: %d → %d целей", added, #targets)
    return added
end

