            end
            if nameOk then
                local rank = _rarityRank[entry.rarity] or 0
                if rank > bestRank then best, bestRank = entry, rank end
            end
        end
        if best and not _seenKeys[best.key] then
            table.insert(ItemsTabList, best); _seenKeys[best.key] = true
        end
    end
end

